# Copy to .env. Never commit the real file.
# Name, email, phone, links, location, work authorization, and salary
# are read from each résumé in input/. Do not put them here.

# openai | anthropic | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave blank to use the provider default (gpt-4.1-mini, claude-sonnet-5-5, or gemini-3.8-flash).
LLM_MODEL=

# Job search
JOB_LOCATION=Remote
REMOTE_ONLY=true
MATCH_THRESHOLD=75
SEARCH_BOARDS=indeed,linkedin
# Public Greenhouse board slugs, comma-separated. Example: stripe,airbnb,notion,figma,discord,gitlab
GREENHOUSE_BOARDS=stripe,airbnb,notion,figma,discord,gitlab,hashicorp

# Browser
BROWSER_PROFILE_DIR=output/browser_profile
HEADLESS=false
MIN_DELAY_SECONDS=0.8
MAX_DELAY_SECONDS=2.2
MIN_BETWEEN_APPLICATIONS=6
MAX_BETWEEN_APPLICATIONS=14

# auto | weasyprint | reportlab
# auto uses WeasyPrint when it imports, and ReportLab otherwise.
PDF_ENGINE=auto
