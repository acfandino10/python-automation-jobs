# Copy to .env. Never commit the real file.
# Name, email, phone, links, location, work authorization, and salary
# are read from the CV. This file is for the API key and search overrides.

# openai | anthropic | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave blank to use the provider default.
LLM_MODEL=

# Job search overrides. Leave blank to use profile.yaml.
JOB_LOCATION=
REMOTE_ONLY=
MATCH_THRESHOLD=
SEARCH_BOARDS=
# Public Greenhouse board slugs, comma-separated. Example: stripe,airbnb
GREENHOUSE_BOARDS=

# Browser
BROWSER_PROFILE_DIR=output/browser_profile
HEADLESS=false
MIN_DELAY_SECONDS=0.8
MAX_DELAY_SECONDS=2.2
MIN_BETWEEN_APPLICATIONS=6
MAX_BETWEEN_APPLICATIONS=14

# auto | weasyprint | reportlab
# auto uses WeasyPrint when it imports, and ReportLab otherwise.
PDF_ENGINE=auto

PROFILE_PATH=profile.yaml
